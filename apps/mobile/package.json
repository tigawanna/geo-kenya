{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "dev:reset-db": "EXPO_PUBLIC_RESET_DATABASE=1 APP_VARIANT=development expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "fetch:spatialite": "node ./scripts/fetch-spatialite-libs.js",
    "eas-build-pre-install": "node ./scripts/fetch-spatialite-libs.js && node ./scripts/materialize-google-services.js",
    "generate:events": "tsx ./scripts/export-sqlite-to-events.ts",
    "export:events": "tsx ./scripts/export-sqlite-to-events.ts",
    "android": "expo run:android",
    "prebuild": "pnpm fetch:spatialite && expo prebuild --clean",
    "prebuild:android": "pnpm fetch:spatialite && expo prebuild -p android --clean",
    "run:android": "pnpm fetch:spatialite && expo run:android",
    "build-dev:local": "eas build --platform android --profile development --local",
    "build:preview": "eas build --platform android --profile preview",
    "build:preview:local": "eas build --platform android --profile preview:local --local",
    "build:preview:eas": "eas build --platform android --profile preview:eas",
    "build:production:local": "eas build --platform android --profile production:local --local",
    "build:store": "eas build --platform android --profile production",
    "submit:store": "eas submit --platform android --profile production",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "check-types": "tsgo --noEmit",
    "db:migrate": "npx drizzle-kit generate"
  },
  "dependencies": {
    "@expo/ui": "~56.0.17",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.3.0",
    "@op-engineering/op-sqlite": "^16.2.0",
    "@pietile-native-kit/keyboard-aware-scrollview": "^1.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/crashlytics": "^23.4.0",
    "@tanstack/react-pacer": "^0.16.3",
    "@tanstack/react-query": "^5.87.4",
    "@uidotdev/usehooks": "^2.4.1",
    "babel-plugin-inline-import": "^3.0.0",
    "deepmerge": "^4.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "expo": "~56.0.11",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.17",
    "expo-background-task": "~56.0.18",
    "expo-build-properties": "~56.0.18",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.17",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.10",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.18",
    "expo-updates": "~56.0.18",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.63.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-pager-view": "8.0.1",
    "react-native-paper": "^5.15.3",
    "react-native-paper-dropdown": "^2.3.1",
    "react-native-paper-tabs": "^0.11.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8",
    "@react-native-vector-icons/material-icons": "^13.1.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "~56.0.8",
    "babel-preset-expo": "~56.0.15",
    "@testing-library/react-native": "^13.3.3",
    "@types/color": "^4.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-plugin-testing-library": "^7.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
