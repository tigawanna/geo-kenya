# Local only. In the browser, auth uses window.location.origin so production
# never calls a baked-in localhost URL.
VITE_API_URL=http://localhost:3070

# Legacy Better Auth Google OAuth (used only when Firebase is not configured)
VITE_GOOGLE_AUTH_ENABLED=false

# Firebase web config (Project settings → Your apps → Web app)
# Enable Email/Password + Google under Authentication → Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Also set FIREBASE_PROJECT_ID in .dev.vars (same value) so the worker can
# verify Firebase ID tokens. Service-account keys are NOT required for the
# email/Google ID-token flow on Cloudflare Workers.
