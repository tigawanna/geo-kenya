{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3070",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "pnpm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:remote-db": "wrangler d1 migrations apply geo-kenya-db --remote",
    "check-types": "tsgo --noEmit",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:studio": "DATABASE_URL=\"file:$(find .wrangler/state/v3/d1 -name '*.sqlite' ! -name metadata.sqlite 2>/dev/null | head -1)\" drizzle-kit studio --port ${DRIZZLE_STUDIO_PORT:-4983}",
    "db:migrate:local": "wrangler d1 migrations apply geo-kenya-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply geo-kenya-db --remote",
    "secrets:sync": "wrangler secret put SYNC_API_SECRET",
    "secrets:auth": "wrangler secret put BETTER_AUTH_SECRET"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.30.1",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanem/react-nprogress": "^6.0.3",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.7",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.168.10",
    "@tanstack/router-plugin": "^1.168.10",
    "better-auth": "1.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.14",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.18.1",
    "hono": "^4.12.18",
    "lucide-react": "^0.561.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.78.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260408.1",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.1.3",
    "drizzle-kit": "^0.31.10",
    "nitro": "3.0.260603-beta",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2"
    }
  }
}
